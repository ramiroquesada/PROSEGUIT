{
  "name": "proseguit",
  "version": "2.0.0",
  "description": "PROSEGUIT - Sistema de Gestión de Inventario IT - Intendencia de Soriano",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate --workspace=backend",
    "db:studio": "npm run studio --workspace=backend",
    "db:seed": "npm run seed --workspace=backend"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0"
  }
}
