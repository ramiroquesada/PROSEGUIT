# ── PROSEGUIT — Variables de entorno para producción ─────────────────────────
# Copiar este archivo a .env.production y completar los valores reales.
# NUNCA commitear .env.production al repositorio.

# Contraseña de PostgreSQL (elegir una contraseña fuerte)
POSTGRES_PASSWORD=cambiar_por_password_segura

# Secretos JWT (generar con: openssl rand -hex 32)
JWT_SECRET=cambiar_por_secreto_largo_aleatorio
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_largo_aleatorio

# Puerto donde se expone la aplicación en el servidor (default: 80)
HTTP_PORT=80
